# Copy to .env in this directory and fill in. Never commit .env.

PORT=3001

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# Google Sheet ID (the long id in the spreadsheet URL)
GOOGLE_SHEET_ID=

# Paths are relative to this repo root (Docker overrides these to /app/...)
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
APP_CONFIG_FILE=./app-config.json

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CORS — local Vite: http://localhost:5173  |  Docker UI: http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (Vite). Docker bakes these in at image build time.
# Local Vite:          VITE_BASE_URL=http://localhost:5173  VITE_API_URL=http://localhost:3001
# Docker on this host: VITE_BASE_URL=http://localhost:3000  VITE_API_URL=http://localhost:3001
VITE_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
